DATABASE_URL=            # Postgres connection string (Neon) — point local dev at your own branch, never shared prod
BETTER_AUTH_SECRET=      # random 32+ byte secret used to sign BetterAuth sessions
REDIS_URL=               # Upstash Redis connection string, used by BullMQ
GOOGLE_PLACES_API_KEY=   # Google Places API key, used by the discovery module
ANTHROPIC_API_KEY=       # Claude API key, used by the drafting module
INSTANTLY_API_KEY=       # Instantly API key, used by the sending module
TELEGRAM_BOT_TOKEN=      # Telegram bot token for operator approval notifications
TELEGRAM_WEBHOOK_SECRET= # shared secret used to verify incoming Telegram webhook requests
HUNTER_API_KEY=          # Hunter.io API key, only used when ENRICHMENT_FALLBACK=hunter
ENRICHMENT_FALLBACK=none # "none" | "hunter" — which EmailFinder/EmailVerifier implementation is active
META_APP_ID=             # Meta app id, used by the Instagram module
META_APP_SECRET=         # Meta app secret, used by the Instagram module
